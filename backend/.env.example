# ==============================================================================
# AgriLink Backend Environment Configuration
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration (debug, info, warn, error)
LOG_LEVEL=info

# External Agricultural Market API (Phase 2 Integration)
MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MARKET_API_KEY=your_api_key_here
MARKET_API_TIMEOUT=10000
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Database Configuration (Phase 5 Integration)
DATABASE_URL=postgresql://user:password@localhost:5432/agrilink?schema=public
